{
  "name": "hmmf",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "HE_OBJECTS",
      "bucket_name": "hmmf-he-objects"
    }
  ]
}
